NODE_ENV=development
# Use 0.0.0.0 when hosting on a platform such as Render.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:zero_waste_demo@127.0.0.1:5432/ZeroWasteDemo?schema=public
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-generate-a-random-secret-before-running
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Explicitly local demo only; ignored in production.
DEMO_PAYMENTS=true

# Optional Google OAuth; email/password login works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Local Mailpit inbox: http://localhost:8025 (docker compose --profile mail up -d)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EcoStore Demo <demo@example.com>
